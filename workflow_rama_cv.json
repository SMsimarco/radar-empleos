{
  "name": "Radar de empleos — rama CV",
  "nodes": [
    {
      "id": "cv-modificado",
      "name": "CV modificado",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        -260,
        200
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "mode": "id",
          "value": "TU_FOLDER_ID_CVS_AQUI"
        },
        "event": "fileUpdated",
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Drive Account"
        }
      }
    },
    {
      "id": "descargar-cv",
      "name": "Descargar CV",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        0,
        200
      ],
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Drive Account"
        }
      }
    },
    {
      "id": "es-pdf",
      "name": "¿Es PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.mimeType }}",
              "rightValue": "application/pdf",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "extraer-texto-pdf",
      "name": "Extraer texto PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        480,
        120
      ],
      "parameters": {
        "operation": "pdf",
        "options": {}
      }
    },
    {
      "id": "texto-desde-google-doc",
      "name": "Texto desde binario (Google Doc)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.all()[0];\nconst buffer = Buffer.from(item.binary.data.data, 'base64');\nreturn { json: { texto_cv: buffer.toString('utf-8') } };"
      }
    },
    {
      "id": "unificar-texto-cv",
      "name": "Unificar texto CV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Junta las dos ramas (Google Doc ya viene como texto plano vía\n// googleFileConversion, PDF viene binario y pasó por \"Extraer texto PDF\").\n// Solo una de las dos ramas trae datos en cada ejecución.\nconst item = $input.all()[0];\nconst texto = item.json.texto_cv || item.json.text || '';\nreturn { json: { texto_cv: texto } };"
      }
    },
    {
      "id": "preparar-prompt-cv",
      "name": "Preparar prompt IA (CV)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const SYSTEM_PROMPT = \"Sos un extractor de datos, no un evaluador. Te paso el texto de un CV y\\ntu única tarea es devolver la lista de tecnologías, lenguajes, frameworks,\\nbases de datos, y herramientas que aparecen LITERALMENTE mencionadas en el\\ntexto. No opines sobre el nivel del candidato, no infieras tecnologías\\n\\\"implícitas\\\" (si dice \\\"React\\\" no agregues \\\"JavaScript\\\" salvo que también\\nesté escrito), no dupliques sinónimos como entradas separadas si el CV usa\\nel mismo término dos veces.\\n\\nDevolvé ÚNICAMENTE este JSON, sin texto antes ni después:\\n\\n{ \\\"tecnologias\\\": string[] }\\n\\nCada elemento en minúscula, tal como aparece o lo más cerca posible del\\ntexto original (ej: \\\"Node.js\\\" -> \\\"node.js\\\", \\\"PostgreSQL\\\" -> \\\"postgresql\\\").\";\nconst userPrompt = `Extraé las tecnologías de este CV según las reglas del system prompt.\n\nTEXTO DEL CV:\n${$json.texto_cv}`;\n\nreturn { json: { ...$json, systemPrompt: SYSTEM_PROMPT, userPrompt } };"
      }
    },
    {
      "id": "extraer-stack-ia",
      "name": "Extraer stack con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-haiku-4-5\", max_tokens: 512, temperature: 0, system: $json.systemPrompt, messages: [{ role: \"user\", content: $json.userPrompt }] }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Anthropic API Key (x-api-key)"
        }
      }
    },
    {
      "id": "parsear-respuesta-cv",
      "name": "Parsear respuesta IA (CV)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let resultado;\ntry {\n  const texto = $json.content && $json.content[0] ? $json.content[0].text : '';\n  resultado = JSON.parse(texto);\n} catch (e) {\n  resultado = { tecnologias: [] };\n}\nreturn { json: { tecnologias: resultado.tecnologias || [] } };"
      }
    },
    {
      "id": "determinar-perfil",
      "name": "Armar fila de perfil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const nombreArchivo = $('CV modificado').item.json.name || 'cv_sin_nombre';\nconst tecnologias = ($json.tecnologias || []).map((t) => String(t).toLowerCase().trim()).filter(Boolean);\n\nreturn {\n  json: {\n    cv_nombre: nombreArchivo,\n    tecnologias: tecnologias.join(', '),\n    fecha_actualizado: new Date().toISOString(),\n  },\n};"
      }
    },
    {
      "id": "guardar-perfil",
      "name": "Guardar perfil",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1920,
        200
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "mode": "id",
          "value": "TU_SHEET_ID_AQUI"
        },
        "sheetName": {
          "mode": "name",
          "value": "Perfil"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "cv_nombre"
          ],
          "value": {
            "cv_nombre": "={{ $json.cv_nombre }}",
            "tecnologias": "={{ $json.tecnologias }}",
            "fecha_actualizado": "={{ $json.fecha_actualizado }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "id": "nota-cv",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -280,
        -160
      ],
      "parameters": {
        "width": 520,
        "height": 300,
        "content": "## Rama CV\n\nSe dispara cuando cambia un archivo en la carpeta de Drive que\nelijas (poné ahí SOLO tus 2 CVs — Automation Engineer y Full\nStack). Extrae el texto (Google Doc o PDF), le pide a Claude la\nlista de tecnologías mencionadas, y la guarda en la tab \"Perfil\"\ndel mismo Sheet — una fila por CV, `cv_nombre` como clave.\n\nLa rama principal lee esa tab en cada corrida diaria y arma\n`CANDIDATO_STACK` como la unión de ambos CVs — no reprocesa el CV\ncada vez, solo lee lo que esta rama ya calculó.\n\nAntes de importar: reemplazar `TU_FOLDER_ID_CVS_AQUI`,\n`TU_SHEET_ID_AQUI`, credenciales (Drive, Anthropic).\nCrear tab \"Perfil\" en el Sheet con headers: cv_nombre,\ntecnologias, fecha_actualizado."
      }
    }
  ],
  "connections": {
    "CV modificado": {
      "main": [
        [
          {
            "node": "Descargar CV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar CV": {
      "main": [
        [
          {
            "node": "¿Es PDF?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Es PDF?": {
      "main": [
        [
          {
            "node": "Extraer texto PDF",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Texto desde binario (Google Doc)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer texto PDF": {
      "main": [
        [
          {
            "node": "Unificar texto CV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Texto desde binario (Google Doc)": {
      "main": [
        [
          {
            "node": "Unificar texto CV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unificar texto CV": {
      "main": [
        [
          {
            "node": "Preparar prompt IA (CV)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar prompt IA (CV)": {
      "main": [
        [
          {
            "node": "Extraer stack con IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer stack con IA": {
      "main": [
        [
          {
            "node": "Parsear respuesta IA (CV)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parsear respuesta IA (CV)": {
      "main": [
        [
          {
            "node": "Armar fila de perfil",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar fila de perfil": {
      "main": [
        [
          {
            "node": "Guardar perfil",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "REEMPLAZAR_CON_ID_DE_workflow_error"
  }
}